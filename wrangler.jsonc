{
  "main": ".open-next/worker.js",
  "name": "portfolio",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
        "pattern": "quiggleson.com",
        "custom_domain": true
    },
    {
        "pattern": "www.quiggleson.com",
        "custom_domain": true
    }
  ]
}